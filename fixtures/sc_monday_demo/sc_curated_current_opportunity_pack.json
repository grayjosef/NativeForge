      "opportunity_number": "BIA-TTGP-2026-OIED",
      "opportunity_title": "Tribal Tourism Grant Program (TTGP)",
      "provenance": {
        "batch_block": "la_scale_federal",
        "grants_gov_opportunity_id": "362968",
        "source_seed_id": "nf-seed-2026-fed-007"
      },
      "real_fetch": true,
      "retrieval_date": "2026-08-20",
