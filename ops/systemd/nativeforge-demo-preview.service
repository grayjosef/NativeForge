[Unit]
Description=NativeForge stamped Vite preview (loopback 127.0.0.1:5175)
Documentation=docs/operations/337_GATE36B_DEV_DOMAIN_DEPLOYMENT_MACHINERY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/josefgray/projects/nativeforge
ExecStart=/home/josefgray/projects/nativeforge/scripts/serve_frontend_preview_5175.sh
# Gate 130B: `always`, not `on-failure`. systemd counts a zero exit as
# success, and cloudflared exits zero when it gives up on its edge
# connections ("no more connections active and exiting"). Under
# `on-failure` that leaves the tunnel down and the hostname serving
# Cloudflare Error 1033, which is what happened during the demo.
Restart=always
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=5
# Loopback-only preview. Does not start cloudflared. No secrets.

[Install]
WantedBy=default.target
