  "prohibited_inferences": [
    {
      "inference": "recognition_status_from_name_or_state",
      "why": "federal, state, historic-affiliation and unrecognised are legally distinct; a wrong guess reaches a real government's eligibility"
    },
    {
      "inference": "federal_eligibility_from_state_recognition",
      "why": "South Carolina recognising a Tribe says nothing about federal programme eligibility, and the inverse is equally false"
    },
    {
      "inference": "operating_state_from_mailing_address",
      "why": "a tenant may operate, serve and be eligible in a state it is not headquartered in"
    },
    {
      "inference": "applicant_class_from_tenant_kind",
      "why": "a tribal government may apply under several classes, and which one applies is per-opportunity"
    }
  ],
