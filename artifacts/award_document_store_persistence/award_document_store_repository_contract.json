  "prohibited_inferences": [
    {
      "inference": "storage_from_object_key",
      "why": "a key is a path. Whether anything is at the end of it is what detect_body_store_mode() answers, and it answers unconfigured"
    },
    {
      "inference": "content_from_metadata",
      "why": "a digest and a length describe a file this repository has never opened. Neither is evidence the file exists"
    },
    {
      "inference": "submission_from_document",
      "why": "attaching a document is not filing it. Gate 126 owns that boundary"
    },
    {
      "inference": "acceptance_from_document",
      "why": "a funder accepting something is a separate event with its own timestamp"
    },
    {
      "inference": "visibility_from_upload",
      "why": "whether a Tribe is shown their own document is a decision somebody makes. A default of true shows a draft to the wrong person exactly once"
    },
    {
      "inference": "document_kind_from_title_or_content_type",
      "why": "Report.pdf could be financial, narrative or performance, and the three have different retention"
    }
  ],
