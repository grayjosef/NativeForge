  "prohibited_inferences": [
    {
      "inference": "obligation_from_requirement_title",
      "why": "a title says what is required, not whether the award requires it. Only human_entered or evidence_extracted provenance can"
    },
    {
      "inference": "due_date_from_recurrence_rule",
      "why": "quarterly says how often, not when. The quarter boundaries a funder uses are in the award terms"
    },
    {
      "inference": "submission_from_document_reference",
      "why": "attaching a document is not filing it"
    },
    {
      "inference": "acceptance_from_submission",
      "why": "filing something is not the funder accepting it"
    },
    {
      "inference": "document_from_document_reference",
      "why": "there is no document store. The reference resolves to nothing"
    },
    {
      "inference": "obligation_from_projected_burden",
      "why": "Gate 91 stamps every projection is_active_obligation False, and this is the other end of that refusal"
    }
  ],
  "projected_source": "projected_from_nofo",
  "real_customer_data_written": 0,
  "rls_anchor": "organization_id",
  "rls_predicate": "organization_id = current_setting('app.current_org_id', true)::uuid AND is_demo = current_setting('app.current_org_is_demo', true)::boolean",
  "row_relationship_column": "awarded_grant_id",
  "rows_deleted": 0,
  "rows_in_the_application_database": 0,
  "rules": [
    "organization_id is required and must be UUID-shaped",
    "awarded_grant_id is required, is a row relationship, and is refused as an anchor",
    "tenant_id, customer_org_id and organization_profile_id are refused as anchors",
    "active_obligation, projected_burden and unsupported_requirement are derived from requirement_source and are never inputs",
    "a projected burden is stored and is never an active obligation",
    "an unsupported document is stored, obliges nobody, and cannot carry a verified or calculated date",
    "an estimated due date is recorded, reported as estimated, and never counted down to",
    "nothing derives a due date from a recurrence rule",
    "a document reference is not a document, and there is no document store",
    "a submission is not an acceptance, and each has its own timestamp",
    "a production write requires customer_auth_live and a verified operational binding",
    "archive by setting archived_at; there is no delete path"
  ],
