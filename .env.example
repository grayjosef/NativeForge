# NativeForge configuration. Copy to `.env` for local development.
#
# This file is committed and must never contain a real value. Every secret
# comes from the environment or a secret manager; nothing here is read at
# build time and nothing here belongs in a container image.
#
# Names match `src/nativeforge/lib/settings.py`, which is the single source of
# truth - if a variable is not there, the application does not read it.

# ─────────────────────────────── required ────────────────────────────────

# Standard SQLAlchemy/libpq URL. PostgreSQL in every deployed environment;
# SQLite is the local development lane only and has no row-level security,
# so it cannot exercise the tenant boundary.
#   deployed:  postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#   local dev: sqlite+pysqlite:///./nativeforge.local.db
DATABASE_URL=postgresql+psycopg://nativeforge:nativeforge@localhost:5432/nativeforge

# ─────────────────────────────── application ─────────────────────────────

NF_APP_NAME=NativeForge
NF_APP_ENV=local

# ──────────────────────────────── identity ───────────────────────────────

# Signs session cookies. Must be supplied out-of-band in any deployed
# environment; the committed local fixture key may never sign a production
# session. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NF_SESSION_SIGNING_KEY=

# Public origin the application is served from, used for callback URLs.
NF_PUBLIC_ORIGIN=http://localhost:8000

# OIDC. Leave blank to keep customer auth inactive.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_CALLBACK_URL=

# ──────────────────────────────── tenancy ────────────────────────────────

# Accepts the unauthenticated `X-NF-Org-Id` header, which names the tenant
# every row-level security policy reads. Defaults to false so an unconfigured
# deployment fails closed. Set true ONLY in local dev and demo lanes.
NF_DEV_ORG_HEADERS=false

# Comma-separated UUIDs for demo organisations.
NF_DEMO_ORG_IDS=

# ─────────────────────────────── deployment ──────────────────────────────
#
# NF_RUN_MIGRATIONS and PORT are read by the container entrypoint, not by
# Settings. They have no effect outside the container.

# Stamped at build time so /health can report what is actually running. A
# container has no .git to interrogate, so it has to be told.
NF_GIT_SHA=unknown
NF_SOURCE_DIRTY=unknown

# Run `alembic upgrade head` on boot. Set false when more than one replica
# runs, and use the entrypoint's `migrate` command as a separate release step
# instead - concurrent upgrades from several containers are a race.
NF_RUN_MIGRATIONS=true

# Injected by most PaaS providers; defaults to 8000.
PORT=8000

# ──────────────────────── feedback Slack alerts ──────────────────────────
#
# Read directly from the environment by `feedback_slack_alert_service`, not
# through Settings. Modes: off | dry_run | live. Default is dry_run, not live,
# and live mode refuses to run without a webhook. Never commit the URL.

NATIVEFORGE_FEEDBACK_ALERT_MODE=dry_run
# NATIVEFORGE_FEEDBACK_SLACK_WEBHOOK_URL=
NATIVEFORGE_FEEDBACK_ALERT_CHANNEL_LABEL=mayhem-feedback

# ───────────────────────── object storage (optional) ─────────────────────

# S3-compatible. All blank means unconfigured, which is a supported state.
RAW_PAYLOAD_OBJECT_STORE_ENDPOINT=
RAW_PAYLOAD_OBJECT_STORE_BUCKET=
RAW_PAYLOAD_OBJECT_STORE_REGION=
RAW_PAYLOAD_OBJECT_STORE_ACCESS_KEY_ID=
RAW_PAYLOAD_OBJECT_STORE_SECRET_ACCESS_KEY=
RAW_PAYLOAD_OBJECT_STORE_FORCE_PATH_STYLE=
